<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %d{"yyyy-MM-dd HH:mm:ss,SSS", UTC} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <encoder>
            <pattern>%-5level %d{"yyyy-MM-dd HH:mm:ss,SSS", UTC} - %msg%n</pattern>
        </encoder>
        <file>modz.log</file>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
